{
  "name": "@sul/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "fixture": "tsx --env-file-if-exists=../../.env src/cli/fixture.ts",
    "crawl": "tsx --env-file-if-exists=../../.env src/cli/crawl.ts",
    "run:cli": "tsx --env-file-if-exists=../../.env src/cli/run.ts",
    "eval": "tsx --env-file-if-exists=../../.env src/cli/eval.ts",
    "verify": "tsx --env-file-if-exists=../../.env src/cli/verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@sul/shared": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "playwright": "1.49.1"
  }
}
