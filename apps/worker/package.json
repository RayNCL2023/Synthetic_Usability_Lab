{
  "name": "@sul/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "fixture": "tsx --env-file-if-exists=../../.env src/cli/fixture.ts",
    "crawl": "tsx --env-file-if-exists=../../.env src/cli/crawl.ts",
    "run:cli": "tsx --env-file-if-exists=../../.env src/cli/run.ts",
    "eval": "tsx --env-file-if-exists=../../.env src/cli/eval.ts",
    "verify": "tsx --env-file-if-exists=../../.env src/cli/verify.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@google/genai": "2.17.1",
    "@sul/shared": "workspace:*",
    "bullmq": "^6.1.2",
    "drizzle-orm": "^0.38.4",
    "ioredis": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "playwright": "1.49.1"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./queue": "./src/queue/index.ts",
    "./queue/run-service": "./src/queue/run-service.ts",
    "./safety/preflight": "./src/safety/preflight.ts",
    "./model/factory": "./src/model/factory.ts",
    "./storage": "./src/storage/s3.ts",
    "./persistence": "./src/persistence/repository.ts"
  }
}
