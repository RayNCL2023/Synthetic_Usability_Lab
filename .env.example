# ---------------------------------------------------------------------------
# Synthetic Usability Lab — environment configuration
#
# Copy to `.env` and fill in. Every service validates its own slice of this
# file at boot and exits with the name of the missing variable (see
# packages/shared/src/env.ts). There are no silent defaults for anything that
# costs money or touches a live site.
# ---------------------------------------------------------------------------

# --- Datastores -------------------------------------------------------------
# Matches docker-compose.yml. Apps run on the host; infra runs in Docker.
DATABASE_URL=postgres://sul:sul@localhost:5432/sul
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) -----------------------------------------
# MinIO locally; Cloudflare R2 or S3 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sul-screenshots
S3_ACCESS_KEY_ID=sulminio
S3_SECRET_ACCESS_KEY=sulminio123
# MinIO needs path-style addressing; real S3/R2 generally does not.
S3_FORCE_PATH_STYLE=true
# How long generated screenshot URLs stay valid, in seconds.
S3_PRESIGN_TTL_SECONDS=3600

# --- Model access -----------------------------------------------------------
# Which provider drives the agent loop and clustering.
SUL_PROVIDER=gemini

# --- Gemini (default provider; free tier) -----------------------------------
GEMINI_API_KEY=
SUL_GEMINI_LOOP_MODEL=gemini-3.7-flash
SUL_GEMINI_CLUSTER_MODEL=gemini-3.7-flash
# Rate limiting is mandatory, not optional: three persona workers share ONE
# bucket, so this is the whole-run rate rather than per worker. Conservative
# until measured against the actual free-tier quota.
SUL_GEMINI_RPM=10
SUL_GEMINI_BURST=1
# -1 lets the model choose a thinking budget; 0 disables thinking entirely.
SUL_GEMINI_THINKING_BUDGET=-1

# --- Anthropic (alternative provider) ---------------------------------------
# Required for live runs only. The /demo/[slug] replay route works without it.
ANTHROPIC_API_KEY=

# Split by call site: per-step work is bounded selection, clustering is
# reasoning. Both models run adaptive thinking by default and default to
# `high` effort, so effort is always set explicitly.
SUL_LOOP_MODEL=claude-sonnet-5
SUL_LOOP_EFFORT=low
SUL_CLUSTER_MODEL=claude-opus-5
SUL_CLUSTER_EFFORT=high

# max_tokens caps thinking AND visible output together. Too low truncates the
# action object mid-object and surfaces as stop_reason=max_tokens.
SUL_LOOP_MAX_TOKENS=4096
SUL_CLUSTER_MAX_TOKENS=8192

# Prompt cache TTL for the stable persona prefix: 5m (write costs 1.25x base
# input) or 1h (2x). 1h needs ~3 reads to break even — measure before switching.
SUL_CACHE_TTL=5m

# --- Per-run budget (hard caps; exceeding any one aborts with partial results)
SUL_MAX_STEPS_PER_PERSONA=8
SUL_MAX_MODEL_CALLS_PER_RUN=40
SUL_MAX_WALL_CLOCK_MS=180000
SUL_MAX_COST_CENTS=50

# --- Browser ----------------------------------------------------------------
# Host dev only. `pnpm eval` always runs inside the pinned Linux Playwright
# image — host and container Chromium render differently (font stacks), which
# moves bounding boxes and therefore pin coordinates.
SUL_HEADLESS=true
SUL_NAV_TIMEOUT_MS=20000
SUL_STEP_TIMEOUT_MS=45000
SUL_USER_AGENT="SyntheticUsabilityLab/0.1 (+https://github.com/your-org/synthetic-usability-lab; automated usability testing)"

# --- Safety and abuse gating ------------------------------------------------
SUL_RESPECT_ROBOTS=true
SUL_DOMAIN_DENYLIST=
# Required to start a live run. Leave blank to disable live runs entirely
# (demo replay still works).
SUL_RUN_PASSCODE=
SUL_RATE_LIMIT_PER_IP_PER_HOUR=3
# Fails closed: when the daily cap is hit, live runs are refused and the UI
# points at /demo/[slug].
SUL_GLOBAL_DAILY_RUN_CAP=100

# --- Services ---------------------------------------------------------------
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
